        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /saved_map/planes
      Use Fixed Frame: true
      Use rainbow: false
      Value: false
    - Class: rviz_default_plugins/Image
      Enabled: false
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Front Camera Tracking
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vins_front/image_track
      Value: false
    - Class: rviz_default_plugins/Image
      Enabled: false
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Back Camera Tracking
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vins_back/image_track
      Value: false
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
        base_link:
          Value: true
        cam1_link:
          Value: true
        cam2_link:
          Value: true
        camera_back_optical_frame:
          Value: true
        camera_front_optical_frame:
          Value: true
        lidar_Link:
          Value: true
        odom:
          Value: true
        os_imu:
          Value: true
        os_lidar:
          Value: true
        os_sensor:
          Value: true
      Marker Scale: 0.5
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Tree:
        odom:
          base_link:
            cam1_link:
              camera_back_optical_frame:
                {}
            cam2_link:
              camera_front_optical_frame:
                {}
            lidar_Link:
              {}
            os_sensor:
              os_imu:
                {}
              os_lidar:
                {}
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/Image
